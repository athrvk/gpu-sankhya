{
  "name": "gpu-sankhya",
  "version": "0.8.0",
  "type": "module",
  "description": "Fast char-CNN extraction of Hinglish and Devanagari Hindi numeric quantities, with CPU and WebGPU backends.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/athrvk/gpu-sankhya.git"
  },
  "homepage": "https://athrvk.github.io/gpu-sankhya/",
  "bugs": {
    "url": "https://github.com/athrvk/gpu-sankhya/issues"
  },
  "keywords": [
    "hindi",
    "hinglish",
    "lakh",
    "crore",
    "number-parsing",
    "nlp",
    "webgpu",
    "indian-numbering",
    "char-cnn",
    "onnx"
  ],
  "author": "Atharva Kusumbia <atharvakusumbia@gmail.com>",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json --emitDeclarationOnly && node scripts/fix-dts-ext.mjs",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "bench": "node --experimental-strip-types bench/bench.mjs",
    "size": "node scripts/size.mjs",
    "site": "node scripts/build.mjs && node scripts/site.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.72",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
